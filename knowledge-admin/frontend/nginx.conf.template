# 由 nginx 官方 image 的 envsubst 機制展開（/etc/nginx/templates/*.template → conf.d/*.conf）。
# ${RAG_ADMIN_API_KEY} 於容器啟動時代入（compose environment ← .env，金鑰不進版控、不進瀏覽器）。
# 其餘 $變數（$host、$http_authorization…）為 nginx 執行期變數，envsubst 只替換「已定義的環境變數」不會誤傷。

# 呼叫端已帶 X-API-Key（伺服器對伺服器整合，如 jgb2）→ 原樣沿用其金鑰；沒帶（後台瀏覽器）→ 注入 admin 金鑰。
# 修（2026-07-29）：§16 的 auth_request 誤擋「帶 API 金鑰但無後台 JWT」的外部整合（403）；
#   此 map ＋ /_admin_auth 放行，讓「API 金鑰呼叫者」與「後台 JWT 呼叫者」在同一 /rag-api 共存。
map $http_x_api_key $rag_api_key {
    ""       "${RAG_ADMIN_API_KEY}";
    default  $http_x_api_key;
}

server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # 檔案上傳大小限制（用於 Excel 匯入等功能）
    client_max_body_size 100M;

    # 上游用「變數」強制每次經 Docker DNS 動態解析（valid=10s）——
    # 否則 nginx 啟動時解析一次就快取死，上游容器重啟換 IP 後全部 502，
    # 得跟著重啟本容器才會好。
    resolver 127.0.0.11 valid=10s;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # API 代理
    location /api/ {
        set $admin_api http://knowledge-admin-api:8000;
        proxy_pass $admin_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # ===== 集中 API 文件入口 =====
    location = /api-docs {
        default_type text/html;
        alias /usr/share/nginx/api-docs.html;
    }

    # ── 內部認證子請求：拿前端帶的 Bearer JWT 問後台「這是誰」──
    # 200 → 已登入；401/403 → auth_request 擋下（前端 401 攔截器導回登入頁＝正確行為）。
    location = /_admin_auth {
        internal;
        # 帶 API 金鑰的呼叫者（外部整合）→ 直接放行、不要求後台 JWT（rag 端會驗那把金鑰）。
        if ($http_x_api_key) { return 200; }
        set $admin_api_auth http://knowledge-admin-api:8000;
        proxy_pass $admin_api_auth/api/auth/me;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Authorization $http_authorization;
    }

    # RAG Orchestrator API 代理 (Phase 1: Multi-Vendor)
    # 前端請求 /rag-api/v1/xxx -> 後端 /api/v1/xxx
    # 2026-07-22：RAG_API_AUTH_ENFORCE 上線後補的管理後台通道——
    #   後台 JWT 驗過（auth_request）才轉發，並於伺服器端注入 X-API-Key
    #   （金鑰只存在 env 與此處，瀏覽器與掃描器拿不到；修「登入即被踢」）。
    location /rag-api/ {
        auth_request /_admin_auth;

        # set 必須在 rewrite...break 之前（break 會中止 rewrite 階段後續指令）
        set $rag_api http://rag-orchestrator:8100;
        rewrite ^/rag-api/(.*)$ /api/$1 break;
        proxy_pass $rag_api;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-API-Key $rag_api_key;

        # SSE 串流支援（禁用 buffering，確保即時傳送）
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;

        # AI 轉換超時設定（規格書轉換可能需要較長時間）
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}
