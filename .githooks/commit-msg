#!/usr/bin/env bash
# 不變量 43（commit 當下擋）：碰知識大綱線路徑的 commit 須附同 commit 內的驗證證據；可引用內容的寫入須全數逐句核對。
# 一律執行**已 commit 的**檢查器（未 commit 的改動不生效）；引導期（HEAD 尚無檢查器）才用工作樹檔。
# 規則與自我測試在 scripts/audit/checks/outline_plan_discipline.py；make audit 逐筆事後補抓繞過者。
# 啟用：git config core.hooksPath .githooks（2026-10-03 業主核可）
set -eu
REPO="$(git rev-parse --show-toplevel)"
REL="scripts/audit/checks/outline_plan_discipline.py"
if git -C "$REPO" cat-file -e "HEAD:$REL" 2>/dev/null; then
  git -C "$REPO" show "HEAD:$REL" | OPD_REPO="$REPO" python3 - --commit-msg "$1"
else
  OPD_REPO="$REPO" python3 "$REPO/$REL" --commit-msg "$1"
fi
