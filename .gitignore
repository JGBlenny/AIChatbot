# Database backups
backups/
*.sql
*.sql.gz
# …但 migrations/種子是部署必需，不屬備份 → 例外進版控
!rag-orchestrator/database/migrations/*.sql
# ⚠️ rollback/ 子目錄同樣是部署必需：上面那條只涵蓋主目錄，
#    2026-09-01 發現 3 支 rollback 檔因此從未進版控（含 T4-B2 carrier migration 的那支）。
!rag-orchestrator/database/migrations/rollback/*.sql
# ⚠️ 但 tools/fix_config.py 每次 `make fix-config APPLY=1` 會**重寫**這支：
#    它是工具產物、無 forward migration、無帳本紀錄 ⇒ ⛔ 不屬 migration artifact
rag-orchestrator/database/migrations/rollback/fix_config_disable_broken_forms_rollback.sql
# 量測契約（凍結的分析定義）同樣不屬備份：它是判準本體，改動即構成量尺變更
!scripts/analysis/*.sql


# 覆蓋率執行產物（基準 coverage-baseline.json 才版控）
rag-orchestrator/tests/.coverage*.json
aichatbot_full_*.dump

# 凍結評測語料本體走 S3（docs/backtest/corpus-20260810/README.md 有取回指令與 SHA-256）
docs/backtest/corpus-20260810/run1-stale-image/
docs/backtest/corpus-20260810/run2-head/
docs/backtest/corpus-20260810/run3-head/
# 逐字稿正本在 s3://jgb2-production-upload/assistant-reports/（真實客戶對話，不進 repo）
docs/backtest/corpus-20260810/reports/
# decision_replay 的重播輸出（每輪重跑即重生，只留 S3/本機工作目錄）
docs/backtest/corpus-20260810/out_*/
# 外部錨點驗證時自 S3 取回的 tarball（正本在 S3，本機只是暫存）
docs/backtest/corpus-20260810/*.tar.gz
.env.bak-20260822
# agent_eval --dump-texts 原文旁路（人工抽審用，⛔ 不進版控；r13 #6）
**/eval/**/texts/
