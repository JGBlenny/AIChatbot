    {
      "id": "tmp:kb:3094",
      "suggested_shelf": "D",
      "why": "租金調整依租約條款、頻率與通知義務，歸位判準：由合約條款決定的歸租約。"
    },
    {
      "id": "tmp:kb:3326",
      "suggested_shelf": "E",
