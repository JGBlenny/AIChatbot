    {
      "id": "tmp:kb:1408",
      "suggested_shelf": "F",
      "why": "推薦水電維修廠商屬修繕，無帳務內容。"
    },
    {
      "id": "tmp:kb:3517",
      "suggested_shelf": "D",
      "why": "點交清單不符如何處理是合約點交流程，非帳單計算。"
    },
    {
      "id": "tmp:kb:3899",
      "suggested_shelf": "D",
      "why": "租客同意點交後的下一步屬合約生命週期；水電基準一句可由水電細目另見。"
    },
    {
      "id": "tmp:kb:3514",
      "suggested_shelf": "E",
      "why": "查詢租客概況（合約/帳單/修繕）為彙總資料查詢，face 資料查詢，不成細目。"
    },
    {
      "id": "tmp:kb:1394",
      "suggested_shelf": "E",
      "why": "停車費金額查詢為個別資料查詢（需車位編號），face 資料查詢，不成細目。"
    },
    {
      "id": "tmp:kb:4050",
      "suggested_shelf": "G",
      "why": "儲值單價在台科電端設定、JGB 僅鏡像顯示，屬裝置設定。"
    },
    {
      "id": "tmp:kb:4059",
      "suggested_shelf": "G",
      "why": "空列，題意為儲值單價設定位置，隨 4050 歸裝置。"
    }
  ]
