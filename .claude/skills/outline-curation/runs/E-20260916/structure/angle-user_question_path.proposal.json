  "out_of_shelf": [
    {
      "id": "tmp:kb:1408",
      "suggested_shelf": "F",
      "why": "推薦水電維修廠商是修繕題，非帳務。"
    },
    {
      "id": "tmp:kb:3517",
      "suggested_shelf": "D",
      "why": "點交清單與現況不符是合約點交流程（不同意重送），非帳單計費。"
    },
    {
      "id": "tmp:kb:3899",
      "suggested_shelf": "D",
      "why": "「點交後下一步」是合約生命週期題，帳單依週期產生只是附帶說明。"
    },
    {
      "id": "tmp:kb:3514",
      "suggested_shelf": "E",
      "why": "查詢某租客的合約／帳單／修繕概況是 face 資料查詢（彙總查詢類），不成細目。"
    },
    {
      "id": "tmp:kb:4047",
      "suggested_shelf": "G",
      "why": "儲值已付款但未復電是電表入值／裝置端問題，非帳務。"
    },
    {
      "id": "tmp:kb:4564",
      "suggested_shelf": "G",
      "why": "與 4047 同題（儲值後未復電），屬裝置。"
    },
    {
      "id": "tmp:kb:4050",
      "suggested_shelf": "G",
      "why": "儲值單價在台科電端設定、JGB 只鏡像顯示，屬裝置設定而非帳務計算。"
    },
    {
      "id": "tmp:kb:4059",
      "suggested_shelf": "G",
      "why": "「儲值單價在哪裡設定」與 4050 同題，屬裝置設定。"
    }
  ]
}