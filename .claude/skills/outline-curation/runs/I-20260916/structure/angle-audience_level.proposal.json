    },
    {
      "id": "tmp:kb:3035",
      "suggested_shelf": "D",
      "why": "戶籍遷移屬租住權益、以租約有效性為主體，歸租約。"
    },
    {
      "id": "tmp:kb:3047",
      "suggested_shelf": "D",
      "why": "居住證明申請屬租住權益，歸租約。"
    },
    {
      "id": "tmp:kb:3105",
