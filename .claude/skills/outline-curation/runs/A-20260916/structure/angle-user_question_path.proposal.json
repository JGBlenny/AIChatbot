        "tmp:draft:3"
      ],
      "moved_from": [],
      "reason": "使用者問「怎麼註冊」是一條問法，房東自註冊與租客從邀請註冊只是答案內的分支；draft:1／draft:3 只取註冊段併入，其餘段拆去帳號資訊設定與登入方式。",
      "target_user": [
        "prospect",
        "property_manager"
      ],
      "op": "merge"
    },
    {
