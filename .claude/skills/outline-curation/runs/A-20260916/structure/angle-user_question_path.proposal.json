  "out_of_shelf": [
    {
      "id": "tmp:kb:3354",
      "suggested_shelf": "D",
      "why": "問的是租賃契約要不要記載／上傳身分證、租客未上傳時退出簽名取消合約，是合約簽署與契約應記載事項，不是帳號身分。"
    },
    {
      "id": "tmp:draft:5",
      "suggested_shelf": "D",
      "why": "租客簽回未附身分證時取消邀請、執行中合約不可更動，屬合約簽署流程。"
    },
    {
      "id": "tmp:draft:2",
      "suggested_shelf": "B",
      "why": "整篇為創建團隊、團隊設置、成員角色權限、大房東管理、訂閱方案、招租網址，屬團隊人員與大房東（訂閱方案段屬 I）。"
    }
  ]
