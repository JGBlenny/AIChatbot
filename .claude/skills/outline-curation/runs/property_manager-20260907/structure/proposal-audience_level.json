    {"id": "property_manager/A/photo-repair-flow-basic", "coarse_id": "A", "title": "拍照開修繕單基本流程與確認機制", "slug": "photo-repair-flow-basic", "merge_of": ["tmp:draft:1"], "split_from": [], "moved_from": [], "reason": "操作層級：開單流程本身，未經確認鍵一律不得建單，此為本受眾唯一需要的操作層級敘述。"},
    {"id": "property_manager/A/category-correction", "coarse_id": "A", "title": "分類辨識結果被修改時的收斂規則", "slug": "category-correction", "merge_of": ["tmp:draft:2"], "split_from": [], "moved_from": [], "reason": "操作層級：修正辨識結果時只重確認被改項目，物件與急迫性不重問，屬同一開單流程下的例外分支。"},
    {"id": "property_manager/A/low-confidence-candidates", "coarse_id": "A", "title": "辨識信心不足時的候選選單", "slug": "low-confidence-candidates", "merge_of": ["tmp:draft:3"], "split_from": [], "moved_from": [], "reason": "操作層級：信心不足時給候選類別而非下拉選單或編造描述，與分類修改（category-correction）是同層級但不同觸發情境，保留為獨立可回答主題。"},
    {"id": "property_manager/A/no-visible-damage-blank", "coarse_id": "A", "title": "照片看不出損壞時的留白規則", "slug": "no-visible-damage-blank", "merge_of": ["tmp:draft:4"], "split_from": [], "moved_from": [], "reason": "操作層級：看不出損壞時描述留空、不得推測編寫，因描述會原樣進單，屬能力邊界而非單純措辭問題，故獨立於分類修改之外。"},
    {"id": "property_manager/A/photo-count-limit", "coarse_id": "A", "title": "辨識照片張數限制", "slug": "photo-count-limit", "merge_of": ["tmp:draft:5"], "split_from": [], "moved_from": [], "reason": "操作層級的技術限制：辨識僅看前 3 張，附件另保存全部，與流程本身區分開避免混淆。"},
    {"id": "property_manager/A/agent-open-ticket-lease-scope", "coarse_id": "A", "title": "業務代開單時的租約查詢範圍", "slug": "agent-open-ticket-lease-scope", "merge_of": ["tmp:draft:6"], "split_from": [], "moved_from": [], "reason": "權限／範圍層級：業務不以自己身分查租約、查不到租約不算錯誤，這是誰能看什麼資料的邊界問題，非單純操作步驟。"},
    {"id": "property_manager/A/urgency-judgment-source", "coarse_id": "A", "title": "急迫程度的判斷來源", "slug": "urgency-judgment-source", "merge_of": ["tmp:draft:7"], "split_from": [], "moved_from": [], "reason": "操作層級：急迫與否由辨識建議、缺值不得預設急迫；其值域與程式碼相反的爭議已收斂在 F（另見 property_manager/F/urgency-value-domain-pending），此處只留正常操作層級敘述，避免同主題重複兩個層級。"},
    {"id": "property_manager/A/create-ticket-failure-retry", "coarse_id": "A", "title": "建單失敗的處理", "slug": "create-ticket-failure-retry", "merge_of": ["tmp:draft:8"], "split_from": [], "moved_from": [], "reason": "操作層級：API 失敗時明講尚未建立並可重試，同會話重複確認不會建立多張單，屬單一可獨立回答的異常處理主題。"},
    {"id": "property_manager/A/vacant-unit-no-lease-allowed", "coarse_id": "A", "title": "空屋無租約仍可開單", "slug": "vacant-unit-no-lease-allowed", "merge_of": ["tmp:draft:9"], "split_from": [], "moved_from": [], "reason": "權限／範圍層級：合約欄位可留空、不因查無租約而中止開單，界定的是「什麼情況仍在受理範圍內」而非操作步驟。"},
    {"id": "property_manager/A/cancel-midway", "coarse_id": "A", "title": "中途取消報修", "slug": "cancel-midway", "merge_of": ["tmp:draft:10"], "split_from": [], "moved_from": [], "reason": "操作層級：任一階段表達取消即結束、不產生新單，屬開單流程的終止分支。"},
    {"id": "property_manager/B/draft-generation-tone-tiers", "coarse_id": "B", "title": "催繳草稿生成邏輯：語氣分級與槽位規則", "slug": "draft-generation-tone-tiers", "merge_of": ["tmp:draft:11"], "split_from": [], "moved_from": [], "reason": "操作層級：依逾期次數分三級語氣、數字一律由呼叫端帶入槽位，模板本身不得出現數字，此為草稿生成機制的唯一層級。"},
    {"id": "property_manager/B/draft-not-auto-send", "coarse_id": "B", "title": "草稿使用邊界：不可一鍵發送給租客", "slug": "draft-not-auto-send", "merge_of": ["tmp:draft:12"], "split_from": [], "moved_from": [], "reason": "權限層級：草稿只推給業務自行複製傳送，不設計一鍵發送，界定的是誰能對租客發出訊息，非生成邏輯本身。"},
    {"id": "property_manager/B/late-fee-clause-in-draft", "coarse_id": "B", "title": "滯納金條款是否寫入草稿", "slug": "late-fee-clause-in-draft", "merge_of": ["tmp:draft:13"], "split_from": [], "moved_from": [], "reason": "操作層級：依合約是否有滯納金條款與語氣等級決定是否提及，屬草稿內容組成規則的獨立可答主題。"},
    {"id": "property_manager/C/overdue-bill-followup-scope", "coarse_id": "C", "title": "逾期帳單追問可答範圍", "slug": "overdue-bill-followup-scope", "merge_of": ["tmp:draft:14", "tmp:kb:3909", "tmp:kb:3913"], "split_from": [], "moved_from": [], "reason": "操作層級：業務對選定帳單可問到的近一年逾期明細與滯納金推算標註，需要帳單狀態與滯納金機制作為支撐事實才能作答，故將對應系統脈絡併入同一可答主題；不含既有帳務對話面向（繳費金流排障/帳單異常/發票/帳單設定/帳單診斷）的完整多輪代理層級，那是更深一層的操作能力，另見 property_manager/F/billing-other-facets-scope-pending。"},
    {"id": "property_manager/C/lease-expiry-followup-scope", "coarse_id": "C", "title": "合約到期追問可答範圍（導向續約面向）", "slug": "lease-expiry-followup-scope", "merge_of": ["tmp:draft:17", "tmp:kb:3799", "tmp:kb:3824", "tmp:kb:3829"], "split_from": [], "moved_from": [], "reason": "操作層級：追問明確進續約面向（非退租收尾），需要合約里程碑與續約判定機制、以及被重用的續約對話規則本身，三者是同一回答能力的必要組成，故合併；合約其他面向（狀態判斷/合約診斷/合約異動/退租收尾/建約引導/簽署排障）不在本追問範圍內，另見 property_manager/F/contract-other-facets-scope-pending。"},
    {"id": "property_manager/C/urgent-repair-followup-scope", "coarse_id": "C", "title": "緊急修繕追問範圍（目前無獨立面向）", "slug": "urgent-repair-followup-scope", "merge_of": ["tmp:draft:18"], "split_from": [], "moved_from": [], "reason": "操作層級：緊急修繕僅在清單照列，第一版不開追問，是否新增修繕歷史面向屬待裁事項，已另立 property_manager/F/repair-history-facet-pending，此處只留現行（無）層級的事實。"},
    {"id": "property_manager/C/meter-item-followup-scope", "coarse_id": "C", "title": "電錶項目追問（導向電表排障面向）", "slug": "meter-item-followup-scope", "merge_of": ["tmp:draft:19", "tmp:kb:4021", "tmp:kb:4089", "tmp:kb:4091"], "split_from": [], "moved_from": [], "reason": "操作層級：電錶項目以 id 直接進槽位、走既有電表排障面向，需要智慧設備名詞、電表排障判因機制與被重用的對話規則本身，四者是同一回答能力的必要組成，故合併；IoT 設定引導（串接/單價/門鎖規則）不是追問查詢範圍，另見 property_manager/F/iot-setup-scope-pending。"},
    {"id": "property_manager/C/followup-session-single-item-boundary", "coarse_id": "C", "title": "追問的單筆會話邊界（不跨戶回答）", "slug": "followup-session-single-item-boundary", "merge_of": ["tmp:draft:15"], "split_from": [], "moved_from": [], "reason": "權限／範圍層級：每筆清單項目是獨立會話，問到別戶時退出並導回清單，界定的是這輪對話能看到誰的資料，橫跨 C 的四個主題共用。"},
    {"id": "property_manager/C/followup-missing-data-in-jgb", "coarse_id": "C", "title": "追問遇到 JGB 沒有的資料時怎麼回", "slug": "followup-missing-data-in-jgb", "merge_of": ["tmp:draft:16"], "split_from": [], "moved_from": [], "reason": "能力層級：明講答不出來、不冒充不推算，是 C 四個追問主題共通的能力邊界原則，非特定於某一筆帳單，故獨立於 overdue-bill-followup-scope 之外。"},
    {"id": "property_manager/C/followup-session-end", "coarse_id": "C", "title": "追問結束與流程收尾", "slug": "followup-session-end", "merge_of": ["tmp:draft:20"], "split_from": [], "moved_from": [], "reason": "操作層級：結束鈕與 30 分鐘過期後的重新進場規則，是 C 追問流程的通用終止與逾時分支。"},
    {"id": "property_manager/D/reply-tone-principles", "coarse_id": "D", "title": "回覆語氣與介面原則", "slug": "reply-tone-principles", "merge_of": ["tmp:draft:21"], "split_from": [], "moved_from": [], "reason": "介面／語氣層級：對象是現場單手用手機的業務或房東，回答短、先給結論、按鈕優先，是統一的表達層級原則。"},
    {"id": "property_manager/D/prohibited-statements", "coarse_id": "D", "title": "禁止事項清單", "slug": "prohibited-statements", "merge_of": ["tmp:draft:22"], "split_from": [], "moved_from": [], "reason": "禁止項層級：不編描述、不推算、不冒充、不代決定、不跨戶、不自動送出寫入動作，六條紅線彙整為一個可獨立查核的主題。"},
    {"id": "property_manager/D/number-sourcing-rule", "coarse_id": "D", "title": "數字的來源規則", "slug": "number-sourcing-rule", "merge_of": ["tmp:draft:23"], "split_from": [], "moved_from": [], "reason": "禁止項／措辭層級：金額、天數、次數、日期一律來自 JGB，推算必須標明並註明以 JGB 為準，屬回覆用語的通則而非某一主題的資料事實。"},
    {"id": "property_manager/E/refuse-or-exit-conditions", "coarse_id": "E", "title": "拒答或退出的情境", "slug": "refuse-or-exit-conditions", "merge_of": ["tmp:draft:24"], "split_from": [], "moved_from": [], "reason": "邊界層級：問到 JGB 沒有的資料、會話範圍以外的物件或人、需寫入但未確認的動作，三種情況一律拒答或退出，是何時說不的核心判準。"},
    {"id": "property_manager/E/identity-and-permission-boundary", "coarse_id": "E", "title": "身分與權限邊界", "slug": "identity-and-permission-boundary", "merge_of": ["tmp:draft:25"], "split_from": [], "moved_from": [], "reason": "權限層級：呼叫方是代管業務或自管房東而非租客，身分由 LINE 綁定推出、只能看自己權限內的物件，是誰在說話與看得到什麼的根本邊界。"},
    {"id": "property_manager/E/session-expiry-window", "coarse_id": "E", "title": "會話存續時間", "slug": "session-expiry-window", "merge_of": ["tmp:draft:26"], "split_from": [], "moved_from": [], "reason": "邊界層級：30 分鐘無動作即清除、過期後不得靜默當新對話處理，界定的是資料邊界的時間維度。"},
    {"id": "property_manager/F/urgency-value-domain-pending", "coarse_id": "F", "title": "急迫值域定義相反，待以 JGB 資料庫裁定", "slug": "urgency-value-domain-pending", "merge_of": ["tmp:draft:27"], "split_from": [], "moved_from": [], "reason": "待裁：程式註解與舊表單值域相反、且缺值預設為急迫；與 property_manager/A/urgency-judgment-source 同一主題不同層級（一個是正常操作敘述、一個是需要裁定的矛盾），另見交叉引用。"},
    {"id": "property_manager/F/repair-history-facet-pending", "coarse_id": "F", "title": "修繕歷史／進度面向是否新建，待裁", "slug": "repair-history-facet-pending", "merge_of": ["tmp:draft:28"], "split_from": [], "moved_from": [], "reason": "待裁：目前沒有對應面向，第一版不開，是否新建屬待業主裁決事項；與 property_manager/C/urgent-repair-followup-scope 同一主題的擴充層級。"},
    {"id": "property_manager/F/draft-endpoint-form-pending", "coarse_id": "F", "title": "催繳草稿端點形式待裁", "slug": "draft-endpoint-form-pending", "merge_of": ["tmp:draft:29"], "split_from": [], "moved_from": [], "reason": "待裁：做成面向內動作或獨立同步端點二選一，屬實作形式選擇，不影響輸出內容規則（模板加語氣等級）。"},
    {"id": "property_manager/F/followup-latency-unverified", "coarse_id": "F", "title": "追問延遲上限待驗", "slug": "followup-latency-unverified", "merge_of": ["tmp:draft:30"], "split_from": [], "moved_from": [], "reason": "待驗：呼叫端逾時 30 秒但追問回覆 p95 尚無實測數據，屬效能待量測而非內容缺口。"},
    {"id": "property_manager/F/contract-other-facets-scope-pending", "coarse_id": "F", "title": "合約其他子面向與對話規則是否納入本受眾範圍，待裁", "slug": "contract-other-facets-scope-pending", "merge_of": ["tmp:kb:3800", "tmp:kb:3801", "tmp:kb:3822", "tmp:kb:3823", "tmp:kb:3825", "tmp:kb:3826", "tmp:kb:3831", "tmp:kb:4005", "tmp:kb:4202", "tmp:kb:4215"], "split_from": [], "moved_from": [], "reason": "待裁：合約狀態判斷／合約診斷／合約異動／退租收尾／建約引導／簽署排障是既有多輪對話代理的完整操作層級，服務對象與介面（extracted_fields/scope 切換多面向）與本受眾單筆照片或單筆帳單快速追問的層級不同；C 只在合約到期一項明確導向續約面向（見 property_manager/C/lease-expiry-followup-scope），其餘合約子面向是否、以何種層級開放給此 LINE OA 受眾，待業主裁決。"},
    {"id": "property_manager/F/billing-other-facets-scope-pending", "coarse_id": "F", "title": "帳務其他子面向與對話規則是否納入本受眾範圍，待裁", "slug": "billing-other-facets-scope-pending", "merge_of": ["tmp:kb:3910", "tmp:kb:3911", "tmp:kb:3912", "tmp:kb:3914", "tmp:kb:3915", "tmp:kb:3916", "tmp:kb:3917", "tmp:kb:3918", "tmp:kb:4214", "tmp:kb:4252"], "split_from": [], "moved_from": [], "reason": "待裁：繳費金流排障／帳單異常／發票／帳單設定引導／帳單診斷及其對話規則是既有多輪帳務診斷代理的完整層級；C 的逾期帳單追問只需帳單狀態與滯納金機制兩項事實即可作答（見 property_manager/C/overdue-bill-followup-scope），未明確要求導向這些既有面向，是否納入待裁。"},
    {"id": "property_manager/F/account-domain-scope-pending", "coarse_id": "F", "title": "帳號領域（註冊／登入／綁定異動／團隊權限）系統知識是否納入本受眾範圍，待裁", "slug": "account-domain-scope-pending", "merge_of": ["tmp:kb:3952", "tmp:kb:3953", "tmp:kb:3954", "tmp:kb:3955", "tmp:kb:3956", "tmp:kb:3983", "tmp:kb:3984", "tmp:kb:3990", "tmp:kb:4001"], "split_from": [], "moved_from": [], "reason": "待裁：A–E 全部粗目均未提及租客或業務自身的註冊、登入、綁定或團隊權限排障，此整組屬完全不同的主題與服務對象（多為代管理者轉述給租客的排障內容），與本受眾的「拍照開單／催繳／今日追問」層級不同，是否收錄待裁。"},
    {"id": "property_manager/F/iot-setup-scope-pending", "coarse_id": "F", "title": "IoT 設定引導系統知識是否納入本受眾範圍，待裁", "slug": "iot-setup-scope-pending", "merge_of": ["tmp:kb:4088", "tmp:kb:4090"], "split_from": [], "moved_from": [], "reason": "待裁：電表串接、儲值單價調整、門鎖密碼規則屬設定引導層級，C 的電錶追問只需要電表排障（現況判因）層級即可作答（見 property_manager/C/meter-item-followup-scope），設定引導是否也要開放給此受眾待裁。"},
    {"id": "property_manager/F/estate-domain-scope-pending", "coarse_id": "F", "title": "物件領域（物件管理／操作引導／現況診斷）系統知識是否納入本受眾範圍，待裁", "slug": "estate-domain-scope-pending", "merge_of": ["tmp:kb:4132", "tmp:kb:4133", "tmp:kb:4134", "tmp:kb:4176", "tmp:kb:4203"], "split_from": [], "moved_from": [], "reason": "待裁：物件刊登、編輯、招租店舖等操作與現況診斷不在 A–E 任一粗目範圍內，屬完全不同的主題，是否收錄待裁。"},
    {"id": "property_manager/F/subscription-domain-scope-pending", "coarse_id": "F", "title": "訂閱領域系統知識是否納入本受眾範圍，待裁", "slug": "subscription-domain-scope-pending", "merge_of": ["tmp:kb:5373", "tmp:kb:5374"], "split_from": [], "moved_from": [], "reason": "待裁：訂閱額度與扣款異常診斷不在 A–E 任一粗目範圍內，屬完全不同的主題，是否收錄待裁。"},
    {"id": "property_manager/F/presales-context-exclude-pending", "coarse_id": "F", "title": "售前系統脈絡誤入本受眾語料，應排除待裁", "slug": "presales-context-exclude-pending", "merge_of": ["tmp:kb:3622"], "split_from": [], "moved_from": [], "reason": "待裁：本受眾明確非售前（brief 已載明⛔不是售前），此則內容為「系統注入用、勿檢索」的售前定位與合規鐵則，與本受眾層級不符，建議排除，交由業主裁決是否移除。"}
