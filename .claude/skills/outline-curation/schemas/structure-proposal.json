{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outline-curation/schemas/structure-proposal.json",
  "type": "object",
  "required": ["step", "skill_version", "inputs_sha", "deterministic", "raw_outputs_path", "cost", "payload"],
  "additionalProperties": false,
  "properties": {
    "step": {"type": "string", "enum": ["structure"]},
    "skill_version": {"type": "string"},
    "inputs_sha": {"type": "object"},
    "deterministic": {"type": "boolean", "enum": [false]},
    "raw_outputs_path": {"type": "string"},
    "cost": {"type": "object"},
    "payload": {
      "type": "object",
      "required": ["proposals", "synthesis"],
      "additionalProperties": false,
      "properties": {
        "proposals": {"type": "array", "items": {"type": "object"}},
        "synthesis": {"type": "object"}
      }
    }
  }
}
