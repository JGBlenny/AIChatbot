{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outline-curation/schemas/phrasing-map.json",
  "type": "object",
  "required": ["step", "skill_version", "inputs_sha", "deterministic", "raw_outputs_path", "cost", "payload"],
  "additionalProperties": false,
  "properties": {
    "step": {"type": "string", "enum": ["phrasing"]},
    "skill_version": {"type": "string"},
    "inputs_sha": {"type": "object"},
    "deterministic": {"type": "boolean"},
    "raw_outputs_path": {"type": ["string", "null"]},
    "cost": {"type": "object"},
    "payload": {
      "type": "object",
      "required": ["phrasings", "similar_pairs"],
      "additionalProperties": false,
      "properties": {
        "phrasings": {"type": "array", "items": {"type": "object"}},
        "similar_pairs": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
