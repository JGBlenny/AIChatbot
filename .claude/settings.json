{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '[ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/outline_gate.py\" ] && exec python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/outline_gate.py\" || exit 0'",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '[ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/outline_gate.py\" ] && exec python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/outline_gate.py\" || exit 0'",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '[ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/outline_gate.py\" ] && exec python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/outline_gate.py\" || exit 0'",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
