              "text": "浴室天花板漏水報修"
            },
            {
              "source": "line-doc:③#A",
              "status": "approved",
              "text": "確認送出"
            },
            {
              "source": "line-doc:③#F",
              "status": "approved",
              "text": "廚房水槽下方漏水報修"
