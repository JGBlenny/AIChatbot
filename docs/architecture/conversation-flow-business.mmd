%% AI 客服對話邏輯——業務版流程圖（給非技術受眾；完整覆蓋所有機制）
%% 對應技術版：conversation-flow-complete.mmd；兩版同步維護
%% 編譯：npx -y @mermaid-js/mermaid-cli -i conversation-flow-business.mmd -o conversation-flow-business.svg
flowchart TB

    classDef resp fill:#dcfce7,stroke:#16a34a,color:#14532d,font-weight:bold
    classDef dec fill:#fef9c3,stroke:#ca8a04
    classDef warn fill:#ffe4e6,stroke:#e11d48
    classDef hl fill:#e0f2fe,stroke:#0284c7
    classDef vendor fill:#ede9fe,stroke:#7c3aed

    START(["👤 用戶在 JGB 平台送出訊息"])
    NOTECH["📌 通路現況（2026-07-16 對 jgb2 程式查實）<br/>已上線進線：業者員工（後台）＋售前訪客<br/>租客／房東進線與照片上傳：<br/>🚧 系統已建成並驗證，等 jgb2 前台串接後開放<br/>未來通路：LINE 官方帳號（規劃中）"]
    START -.-> NOTECH

    %% ═══ 開場判斷（由上而下，命中就直接走） ═══
    subgraph GATEKEEP["開場判斷（依序檢查，命中就直接接手）"]
        ONGOING{"1️⃣ 有正在進行中的服務？"}
        ENTRYBTN{"2️⃣ 帶著指定主題進來？<br/>（特定入口／深連結參數，<br/>例：從報修頁開啟客服）"}
        PHOTO{"3️⃣ 有附損壞照片？<br/>（🚧 前台附圖待串接）"}
        VISION["🖼️ AI 影像辨識<br/>判斷損壞的東西和嚴重程度"]
        WHO{"4️⃣ 是潛在客戶嗎？<br/>（還不是會員）"}
        GATECHK{"該業者有開這個功能？<br/>（例：報修開關）"}
        ONGOING -->|"都沒有"| ENTRYBTN
        ENTRYBTN -->|"一般輸入"| PHOTO
        PHOTO -->|"有"| VISION
        PHOTO -->|"沒有"| WHO
        ENTRYBTN -->|"是"| GATECHK
        VISION -->|"辨識出損壞"| GATECHK
    end
    VISION -->|"認不出／非損壞照片"| RVIS["🙋 請改用文字描述<br/>或提供更清晰的照片"]
    START --> ONGOING
    ONGOING -->|"表單填到一半"| COLLECT
    ONGOING -->|"多輪對話進行中"| ASKMISS
    GATECHK -->|"有開"| AGENTSTART
    GATECHK -->|"關閉"| RGATE["🙋 說明此服務未開放<br/>引導聯絡客服"]
    NOTESSE["💬 呈現方式：所有回覆<br/>逐字即時顯示（像真人打字）"]
    START -.-> NOTESSE
    WHO -->|"是"| PRESALE
    WHO -->|"否（租客／房東／業者員工）"| HOT

    %% ═══ 先看熱門，再找答案 ═══
    HOT{"最近答過的熱門問題？"}
    HOT -->|"是"| R1["✅ 立即回覆標準答案"]
    UNDERSTAND["AI 先理解問題（改寫口語、判斷意圖）<br/>一句話同時問到多件事也能一起判斷<br/>（以主要問題為主，可帶到相關主題）"]
    HOT -->|"否"| UNDERSTAND
    STAFF{"是業者員工嗎？"}
    UNDERSTAND --> STAFF
    SEARCH["🔍 同時查兩個來源：<br/>業者 SOP（該業者自訂）<br/>＋知識庫（平台共通為主，可加掛業者專屬）"]
    STAFF -->|"租客／房東"| SEARCH
    STAFF -->|"業者員工"| STAFFKB
    JUDGE{"哪邊的答案比較切題？<br/>（都切題時，有後續服務的優先<br/>→ 業者客製壓過平台通用）"}
    SEARCH --> JUDGE
    PARAMTRY{"問的是業者基本資料？<br/>（電話、營業時間、地址⋯）"}
    JUDGE -->|"兩邊都不夠切題"| PARAMTRY
    PARAMTRY -->|"是"| RPARAM["✅ 用業者登錄的資料直接答"]
    PARAMTRY -->|"否"| R4["🙋 禮貌說明沒有把握回答<br/>並提供真人客服管道"]

    %% ═══ 業者員工路線 ═══
    STAFFKB["查 JGB 平台系統操作知識庫<br/>（平台共通、不分業者，按角色給內容；<br/>無 SOP、無表單，可進入查詢診斷對話）"]
    STAFFKB --> KTYPE

    %% ═══ 路線一：業者 SOP ═══
    subgraph SOPF["路線一：業者 SOP（各業者自訂的處理流程）"]
        SOPSHOW["先照 SOP 說明處理步驟<br/>（例：冷氣不冷 → 先檢查濾網）"]
        SOPMODE{"這條 SOP 設定的接手方式？"}
        SOPWAIT["等用戶說「試過了還是不行」<br/>這類關鍵字才接手"]
        SOPASKGO["主動問一句：<br/>「需要幫您安排處理嗎？」<br/>（反問、答非所問、或回一長串<br/>像在講新的事，都不算同意）"]
        SOPNEXT{"接手後做什麼？<br/>（依 SOP 設定）"}
        SOPSHOW --> SOPMODE
        SOPMODE -->|"等用戶開口"| SOPWAIT
        SOPMODE -->|"主動詢問"| SOPASKGO
        SOPWAIT -->|"用戶開口了"| SOPNEXT
        SOPASKGO -->|"用戶說好"| SOPNEXT
    end
    JUDGE -->|"業者 SOP 較切題"| SOPSHOW
    SOPMODE -->|"純說明，不接服務"| R2["✅ 回覆處理步驟"]
    SOPWAIT -->|"用戶沒再反應"| R2
    SOPASKGO -->|"用戶說不用"| R2
    SOPNEXT -->|"幫用戶填資料<br/>（填完可自動送出）"| COLLECT
    SOPNEXT -->|"幫用戶查系統"| QUERY

    %% ═══ 路線二：一般問答（知識庫） ═══
    subgraph KBF["路線二：一般問答（知識庫）"]
        KTYPE{"這則知識設定的後續動作？"}
        POLISH["AI 把答案整理成親切好讀的說法<br/>需要時綜合多則知識"]
        BRAND["帶入該業者的名稱、<br/>客服電話、營業時間"]
        KTYPE -->|"直接回答"| POLISH --> BRAND
    end
    JUDGE -->|"知識庫較切題"| KTYPE
    BRAND --> R3["✅ 回覆答案"]
    KTYPE -->|"需要收集資料（依設定：直接開始／<br/>先問一句同意／等特定關鍵字）"| COLLECT
    KTYPE -->|"需要查系統"| QUERY
    KTYPE -->|"需要多輪釐清<br/>（問題夠明確、且該主題<br/>有設定多輪劇本才轉）"| DIAG

    %% ═══ 路線三：引導填表 ═══
    subgraph FORM["路線三：引導填表"]
        COLLECT["一次問一項，逐步收集<br/>每一項都檢查格式（電話、日期⋯）"]
        DIGRESS["中途問別的問題 → 先回答，<br/>再問你要不要繼續填（說「繼續」才回表單）<br/>說「不填了」→ 隨時可取消<br/>放著不理 → 暫停，回來能接著填<br/>（30 分自動清理已寫成、尚未啟用）"]
        REVIEW["全部填完 → 給摘要請用戶確認<br/>可逐項修改，確認才送出"]
        AFTERFORM{"送出後接什麼？（依表單設定）"}
        COLLECT -.-> DIGRESS
        COLLECT --> REVIEW
        REVIEW -->|"確認送出"| AFTERFORM
    end
    REVIEW -->|"取消"| R5["✅ 取消，資料不送出"]
    AFTERFORM -->|"查系統／建立資料（失敗最多重試 2 次，<br/>試滿依失敗原因說明後結束）"| QUERY
    AFTERFORM -->|"顯示相關說明"| R6["✅ 回覆結果"]
    AFTERFORM -->|"依答案分岔接下一份表單<br/>（例：報修後追問金流，最多接 3 層）"| COLLECT

    %% ═══ 路線四：智慧多輪對話 ═══
    subgraph AGENT["路線四：智慧多輪對話（同一顆引擎，三種用途）"]
        PRESALE["💼 售前諮詢（潛在客戶）<br/>介紹平台服務與方案<br/>不碰個資、不報價、競品保持中立"]
        DIAG["🩺 查詢診斷類（租客／房東／業者員工）<br/>合約、帳單、帳號、電表、物件⋯<br/>自動調閱真實資料：剛好一筆→直接說明<br/>多筆→列出來請你選（選不出來會再問一次）<br/>查不到→反問確認<br/>AI 只負責把事實講清楚，不編造數字"]
        AGENTSTART["📝 申辦類（例：報修）<br/>自動帶入該用戶的租約與房屋資料<br/>照片辨識結果也自動填入<br/>➡️ 已知的不重複問"]
        ASKMISS["只問缺少的資訊（例：急不急？）<br/>中途岔題也會先回答再繼續<br/>對話中再上傳照片也會自動併入"]
        CONFIRM{"送出前一定先給摘要請用戶確認<br/>（要修改就改，改完再確認；<br/>回答模糊時寧可再問，不會擅自送出）"}
        SWITCHN["中途換主題？<br/>→ 自動換到對的服務重新處理"]
        AGENTSTART --> ASKMISS --> CONFIRM
        PRESALE -.-> SWITCHN
        DIAG -.-> SWITCHN
        ASKMISS -.-> SWITCHN
    end
    PRESALE --> R10["✅ 回覆諮詢（可繼續追問）"]
    DIAG --> R11["✅ 依真實資料說明（可繼續追問）"]
    EXEC["確認後才真正建立報修單"]
    CONFIRM -->|"✅ 確認"| EXEC
    CONFIRM -->|"取消"| R7["✅ 取消，不留半筆資料"]
    EXEC -->|"成功"| R8["✅ 回覆報修單號＋後續追蹤方式<br/>（再按一次也不會重複建單）"]
    EXEC -->|"失敗"| FAIL["⚠️ 誠實告知失敗、提供重試<br/>絕不假裝成功"]

    %% ═══ 查系統 ═══
    QUERY["🔎 查詢平台正式資料<br/>（合約、帳單、修繕進度、電表⋯）<br/>用固定格式呈現，數字不經 AI 改寫<br/>一定核對用戶身分，只給本人資料<br/>身分或參數不足 → 明說缺什麼才能查"]
    QUERY --> R9["✅ 回覆查詢結果"]

    %% ═══ 業者客製層 ═══
    subgraph VENDORLAYER["🏢 業者客製層（在這些點介入；內容主體是平台共通，所有業者共用）"]
        direction LR
        VKB["業者 SOP＝完全業者自訂<br/>知識庫＝平台共通為主，可加掛業者專屬<br/>（專屬內容只有該業者看得到，<br/>並依業態只出現該出現的）"]
        VPARAM["業者參數<br/>（公司名稱、客服電話、營業時間）"]
        VSWITCH["功能開關<br/>（例：報修功能可整個關閉，<br/>關閉時改引導找客服）"]
        VDATA["業者資料集<br/>（例：社區、店點清單）"]
        VQUOTA["用量計量與額度管制<br/>（每則對話都計量，<br/>接近上限自動通知業者）"]
    end
    SEARCH -. "取用" .-> VKB
    BRAND -. "帶入" .-> VPARAM
    GATECHK -. "查開關" .-> VSWITCH
    QUERY -. "取用" .-> VDATA
    START -. "每則計量" .-> VQUOTA
    OUT["✅ 用戶收到的每則回覆＝<br/>知識／SOP 文本 ＋ 業者參數與文案 ＋ 平台正式資料<br/>AI 只負責措辭組裝（追問／兜底等引導語除外）"]
    KBCOMP == "內容成為回覆" ==> OUT
    VENDORLAYER == "參數與文案嵌入回覆" ==> OUT
    style OUT fill:#dcfce7,stroke:#16a34a

    %% ═══ 知識庫組成 ═══
    subgraph KBCOMP["📚 知識庫的組成（同一個知識庫，平台共通，按「角色」分區隔離）"]
        direction LR
        KBT["租客／房東區<br/>FAQ、服務與<br/>平台使用知識"]
        KBPM["JGB 系統操作區<br/>（給業者員工的<br/>後台操作知識）"]
        KBPS["售前介紹區<br/>（給潛在客戶的<br/>服務與方案說明）"]
        KBRULE["多輪對話設定區（劇本）<br/>查詢型：合約、帳單、電表⋯<br/>申辦型：報修建單<br/>售前型：服務諮詢"]
    end
    SEARCH -. "查" .-> KBT
    STAFFKB -. "查" .-> KBPM
    PRESALE -. "查" .-> KBPS
    AGENT -. "載入劇本" .-> KBRULE

    class ONGOING,ENTRYBTN,PHOTO,WHO,HOT,STAFF,JUDGE,SOPMODE,SOPNEXT,KTYPE,AFTERFORM,CONFIRM,GATECHK,PARAMTRY dec
    class R1,R2,R3,R5,R6,R7,R8,R9,R10,R11,RPARAM resp
    class R4,FAIL,RGATE,RVIS warn
    class VISION,AGENTSTART,PRESALE,DIAG,QUERY hl
    class VKB,VPARAM,VSWITCH,VDATA,VQUOTA vendor
    class KBT,KBPM,KBPS,KBRULE data
    classDef data fill:#f1f5f9,stroke:#64748b
