{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feature-coverage（步 0b 產物；每格×每開放身分的判定，D5；步 1 --gapmap 輸入）",
  "type": "object",
  "required": ["surface_json", "surface_jgb2_sha", "cells"],
  "properties": {
    "surface_json": {"type": "string"},
    "surface_jgb2_sha": {"type": "string"},
    "cells": {"type": "array", "items": {"type": "object",
      "required": ["unit_id", "by_identity"],
      "properties": {
        "unit_id": {"type": "string"},
        "by_identity": {"type": "object",
          "required": ["prospect", "property_manager"],
          "additionalProperties": false,
          "properties": {
            "prospect": {"$ref": "#/$defs/judgement"},
            "property_manager": {"$ref": "#/$defs/judgement"}
          }}
      }}}
  },
  "$defs": {
    "judgement": {"type": "object", "required": ["verdict", "fine_ids", "note"],
      "properties": {"verdict": {"enum": ["covered", "partial", "missing", "tenant_not_open", "internal", "out_of_scope"]},
                     "fine_ids": {"type": "array", "items": {"type": "string"}},
                     "note": {"type": "string"}}}
  }
}
